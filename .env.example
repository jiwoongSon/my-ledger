# ==============================================================================
# MyLedger Environment Configuration
# Copy this file to .env and replace placeholder values with your own secrets.
# NEVER commit .env to Git.
# ==============================================================================

# Server
SERVER_PORT=8080

# PostgreSQL Connection (Neon / Supabase / Local Docker PostgreSQL)
# Example (Neon):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-host>/<db>?sslmode=require
# Example (Supabase):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Example (Docker Compose local PostgreSQL):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/myledger
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/myledger
SPRING_DATASOURCE_USERNAME=myledger
SPRING_DATASOURCE_PASSWORD=change_me_strong_db_password

# Local Docker PostgreSQL container settings (used by docker-compose.yml)
POSTGRES_DB=myledger
POSTGRES_USER=myledger
POSTGRES_PASSWORD=change_me_strong_db_password

# Single-User Login Credentials (Spring Security)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_strong_login_password

# JPA DDL Strategy (update for initial setup, validate for production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Application Timezone
APP_TIMEZONE=Asia/Seoul
